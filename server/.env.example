NODE_ENV=development
PORT=5000
RUN_MIGRATIONS=false

# Development database (WAMPserver / MariaDB / MySQL) - uncomment for local dev
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=digital_id_card

JWT_SECRET=your_jwt_secret_key
JWT_EXPIRY=24h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@company.local

# Production database (Hostinger / AWS RDS / any PostgreSQL provider) - required for production
# DATABASE_URL=postgres://user:password@host:5432/digital_id_card

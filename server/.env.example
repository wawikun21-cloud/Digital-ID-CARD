NODE_ENV=development
PORT=5000
RUN_MIGRATIONS=

# Development database (WAMPserver / MariaDB) - uncomment for local dev
DB_DRIVER=mariadb
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_id_card

JWT_SECRET=your_jwt_secret_key
# Production database (Hostinger - PostgreSQL) - required for production
DATABASE_URL=postgres://user:password@localhost:5432/digital_id_card
